pkgbase = pgprc
	pkgdesc = Pretty Good Packet Radio Client — a Linux-native AGWPE/AX.25/KISS packet radio client
	pkgver = 0.1.0
	pkgrel = 2
	url = https://example.invalid/packet-radio
