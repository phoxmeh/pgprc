	optdepends = linux-lts: native Linux AX.25 modem support
	optdepends = libax25: native Linux AX.25 modem support
	optdepends = ax25-tools: native Linux AX.25 modem support
	optdepends = ax25-apps: native Linux AX.25 modem support
	conflicts = packet-radio
	replaces = packet-radio
	options = !lto

pkgname = pgprc
