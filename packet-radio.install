# pacman install hook for packet-radio.
#
# Refreshes the desktop-entry and hicolor icon caches so the launcher entry
# and its icon actually show up after install — the previous package
# release shipped the .desktop file and .svg icon but never explicitly
# refreshed either cache. Most systems pick this up anyway via pacman hooks
# from desktop-file-utils/hicolor-icon-theme, but doing it explicitly here
# guarantees it regardless of what else is installed, and matches standard
# Arch packaging practice for any package shipping desktop files/icons.

_refresh_caches() {
    command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database -q /usr/share/applications 2>/dev/null || true
    command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -q /usr/share/icons/hicolor 2>/dev/null || true
}

post_install() {
    _refresh_caches
}

post_upgrade() {
    _refresh_caches
}

post_remove() {
    _refresh_caches
}
